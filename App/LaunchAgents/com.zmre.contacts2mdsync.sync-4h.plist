<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Background sync while the app is closed (Settings > General). Registered
  with SMAppService.agent(plistName:) from the app bundle's
  Contents/Library/LaunchAgents; runs the app binary headless
  ("contacts2md sync" quietly, architecture §15). One plist per interval
  because StartInterval is fixed. Keep in sync with UIBackgroundSync.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.zmre.contacts2mdsync.sync-4h</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Contacts2MdSync</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contacts2MdSync</string>
		<string>sync</string>
		<string>--quiet</string>
	</array>
	<key>StartInterval</key>
	<integer>14400</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.zmre.contacts2mdsync</string>
	</array>
</dict>
</plist>
