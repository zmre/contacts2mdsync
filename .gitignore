# Xcode project is generated by XcodeGen from App/project.yml
*.xcodeproj
*.xcworkspace
xcuserdata/
*.xcuserstate

# Build products
build/
.build/
DerivedData/

# SwiftPM local state (Package.resolved is intentionally tracked)
.swiftpm/

# Nix
result
result-*

# direnv
.direnv/

# macOS
.DS_Store

# A common global ignore of vim swap files (`*.sw*`) also matches Swift
# sources and tool configs; re-include them explicitly.
!*.swift
!.swift-format
!.swiftlint.yml
